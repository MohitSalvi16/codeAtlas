# ------------------------------------------------------------------
# CodeAtlas — environment variables
# Copy to `.env.local` and fill in. App runs WITHOUT keys using mock
# data + Web Speech fallback, but real keys unlock live features.
# ------------------------------------------------------------------

# Sarvam AI — the ONLY key CodeAtlas needs. Powers chat answers + voice.
# https://dashboard.sarvam.ai  (paste your key here — mark it default in the dashboard)
SARVAM_API_KEY=

# Chat / LLM answers (OpenAI-compatible /v1/chat/completions)
# Available: sarvam-105b (most capable) | sarvam-30b (faster)
SARVAM_CHAT_MODEL=sarvam-105b

# Speech-to-Text (saarika) + Text-to-Speech (bulbul:v3). Speaker e.g. shubh / anushka.
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# Default TTS output language (BCP-47), e.g. hi-IN, en-IN.
SARVAM_TTS_LANGUAGE=en-IN

# GitHub token — optional, raises REST rate limit + enables private repos
# https://github.com/settings/tokens (public_repo scope is enough)
GITHUB_TOKEN=
